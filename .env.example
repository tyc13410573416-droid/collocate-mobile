# Server-side only. Existing JSON text adapter remains separate from native Nexent.
APP_MODE=demo
HOST=127.0.0.1
PORT=5050

# Native Nexent API base, including /api. Main runtime and MinIO must be reachable.
NEXENT_BASE_URL=
NEXENT_IMAGE_AGENT_ID=
# Uses native analyze_image + a configured VLM; no data-process OCR required.
# Verified against v2.8.1. Explicit v1.8 remains available for legacy deployments.
NEXENT_IMAGE_PROTOCOL=v2.8.1
NEXENT_API_KEY=
# Optional: the actual MinIO bucket, only needed if storage returns no URL.
NEXENT_ATTACHMENT_BUCKET=

# Exact browser origin, no path. Needed only if Pages uses an external HTTPS proxy.
IMAGE_ALLOWED_ORIGINS=https://tyc13410573416-droid.github.io
