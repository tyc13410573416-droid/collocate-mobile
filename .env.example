# Server-side only. Existing JSON text adapter remains separate from native Nexent.
APP_MODE=demo
HOST=127.0.0.1
PORT=5050

# Native Nexent API base, including /api. Leave empty until service is repaired.
NEXENT_BASE_URL=
NEXENT_IMAGE_AGENT_ID=
# Verified against official v1.8.0; confirm teammate deployment version before use.
NEXENT_IMAGE_PROTOCOL=v1.8
NEXENT_API_KEY=

# Exact browser origin, no path. Needed only if Pages uses an external HTTPS proxy.
IMAGE_ALLOWED_ORIGINS=https://tyc13410573416-droid.github.io
